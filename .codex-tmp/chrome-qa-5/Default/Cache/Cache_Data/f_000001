.project-title small{max-width:280px;line-height:1.5}
.project-window{top:78px;right:28px;width:68%;height:62%;transform:rotateY(-3deg) rotateX(1deg);translate:none!important}
.project-backdrop span{font-size:14vw}
.rail-status{position:absolute;left:5vw;right:5vw;bottom:3.5vh;z-index:4;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:20px;color:#8d8385;font:8px var(--mono);letter-spacing:.1em;text-transform:uppercase}
