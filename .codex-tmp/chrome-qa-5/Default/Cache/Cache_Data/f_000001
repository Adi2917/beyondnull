/* Portfolio v2: compact work rail, command center and pull interaction */
.intro-mark{width:190px;height:190px;padding:0;overflow:hidden;border:1px solid rgba(255,255,255,.18);background:#fff;box-shadow:0 0 0 14px rgba(255,255,255,.025),0 40px 100px rgba(0,0,0,.45)}
.intro-mark img{width:100%;height:100%;object-fit:cover}
.intro-shutter{position:absolute;top:0;bottom:0;z-index:1;width:50%;background:#0b090a;transition:transform 1s cubic-bezier(.76,0,.24,1)}
.intro-shutter-left{left:0;border-right:1px solid rgba(255,255,255,.08)}
.intro-shutter-right{right:0;border-left:1px solid rgba(255,255,255,.08)}
.intro.done .intro-shutter-left{transform:translateX(-102%)}
.intro.done .intro-shutter-right{transform:translateX(102%)}
.intro-mark,.intro p,.intro-progress,.intro>strong{z-index:2}
.brand img{object-fit:cover;object-position:center}
.rope-trigger{position:absolute;top:0;right:11vw;z-index:12;width:86px;height:70vh;padding:0;border:0;background:transparent;color:#fff;cursor:pointer;transform-origin:top center;animation:ropeSway 5s ease-in-out infinite}
.rope-line{position:absolute;top:0;left:50%;width:1px;height:calc(100% - 72px);background:linear-gradient(to bottom,#575052 0%,#d71935 84%,#d71935 100%)}
.rope-line:after{content:"";position:absolute;left:-4px;bottom:-4px;width:9px;height:9px;border-radius:50%;background:var(--red);box-shadow:0 0 20px var(--red)}
.rope-handle{position:absolute;left:50%;bottom:0;display:grid;width:72px;height:72px;place-items:center;border:1px solid rgba(255,255,255,.38);border-radius:50%;background:#171314;transform:translateX(-50%);transition:.3s}
.rope-handle b{font:8px var(--mono);letter-spacing:.12em;text-transform:uppercase;transform:translateY(-7px)}
.rope-handle i{position:absolute;bottom:14px;color:var(--red);font-style:normal}
.rope-trigger:hover .rope-handle{background:var(--red);border-color:var(--red);transform:translateX(-50%) scale(1.08)}
.rope-trigger:hover .rope-handle i{color:#fff}
.rope-climber{position:absolute;left:50%;bottom:115px;width:32px;height:61px;transform:translateX(-50%) rotate(-7deg)}
.rope-climber i{position:absolute;top:0;left:11px;width:12px;height:12px;border-radius:50%;background:#e9e4df}
.rope-climber b{position:absolute;top:13px;left:13px;width:7px;height:29px;border-radius:5px;background:#e9e4df;transform:rotate(6deg)}
.rope-climber:before,.rope-climber:after{content:"";position:absolute;top:19px;width:4px;height:28px;border-radius:4px;background:#e9e4df;transform-origin:top}
.rope-climber:before{left:12px;transform:rotate(49deg)}
.rope-climber:after{right:11px;transform:rotate(-32deg)}
.rope-climber em{position:absolute;left:11px;top:38px;width:4px;height:24px;border-radius:4px;background:#e9e4df;box-shadow:10px 0 0 #e9e4df;transform:rotate(12deg)}
.rope-trigger.pulling{animation:none;transform:translateY(24vh)}
.rope-trigger.pulling .rope-line{height:calc(100% - 42px)}
.rope-trigger.pulling .rope-handle{background:var(--red)}
@keyframes ropeSway{0%,100%{transform:rotate(1.2deg)}50%{transform:rotate(-1.2deg)}}

.work-intro{min-height:92vh;padding-bottom:18vh}
.work-intro>p{max-width:660px;font-size:17px}
.projects{position:relative;height:520vh;background:#0e0c0d}
.project-rail{position:sticky;top:0;height:100svh;overflow:hidden;background:#0e0c0d}
.project-rail:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:6.25vw 6.25vw;pointer-events:none}
.project-track{position:relative;z-index:2;display:flex;gap:3vw;width:max-content;height:100%;padding:10vh 5vw 11vh;will-change:transform}
