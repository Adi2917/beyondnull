.project-sticky,.project.inverse .project-sticky{position:relative;top:auto;width:100%;height:100%;padding:27px;overflow:hidden;border:1px solid rgba(255,255,255,.17);background:#171314;color:#fff;perspective:none;transform:none!important;box-shadow:0 35px 100px rgba(0,0,0,.32)}
.project.inverse .project-sticky{background:#f1ede8;color:#171314;border-color:rgba(18,15,16,.17)}
